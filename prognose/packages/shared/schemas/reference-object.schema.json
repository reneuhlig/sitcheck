{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitcheck.dev/schemas/reference-object.schema.json",
  "title": "ReferenceObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_id",
    "reference_type",
    "source_type",
    "label",
    "metadata",
    "created_at"
  ],
  "properties": {
    "reference_id": { "type": "string", "minLength": 3 },
    "zone_id": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "reference_type": { "type": "string", "minLength": 2 },
    "source_type": { "type": "string", "minLength": 2 },
    "label": { "type": "string", "minLength": 2 },
    "uri_or_path": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "checksum": {
      "oneOf": [
        { "type": "string", "minLength": 8 },
        { "type": "null" }
      ]
    },
    "imported_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "time_from": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "time_to": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "row_count": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "metadata": { "type": "object", "additionalProperties": true },
    "created_at": { "type": "string", "format": "date-time" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitcheck.dev/schemas/llm-explanation-response.schema.json",
  "title": "LlmExplanationResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["narrative", "structured"],
  "properties": {
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_liner", "warum", "unsicherheit", "empfehlung", "evidence_hinweis"],
      "properties": {
        "one_liner": { "type": "string" },
        "warum": { "type": "string" },
        "unsicherheit": { "type": "string" },
        "empfehlung": { "type": "string" },
        "evidence_hinweis": { "type": "string" }
      }
    },
    "structured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "zone_id",
        "horizon",
        "verdict",
        "top_drivers",
        "uncertainty",
        "recommended_actions",
        "evidence_refs",
        "confidence_statement",
        "limitations"
      ],
      "properties": {
        "audience": { "type": "string", "enum": ["ops", "executive", "enduser", "professor"] },
        "zone_id": { "type": "string", "minLength": 1 },
        "horizon": { "type": "integer", "minimum": 1 },
        "verdict": {
          "type": "string",
          "enum": ["monitor", "attention", "action_needed", "blocked"]
        },
        "top_drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "impact", "direction", "evidence_ref"],
            "properties": {
              "name": { "type": "string" },
              "impact": { "type": "number" },
              "direction": { "type": "string", "enum": ["up", "down", "mixed"] },
              "evidence_ref": { "type": "string", "minLength": 3 }
            }
          }
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "level", "reason", "evidence_ref"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "level": { "type": "string", "enum": ["low", "medium", "high"] },
            "reason": { "type": "string" },
            "evidence_ref": { "type": "string", "minLength": 3 }
          }
        },
        "recommended_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action_type", "priority", "rationale", "evidence_ref"],
            "properties": {
              "action_type": { "type": "string" },
              "priority": { "type": "integer", "minimum": 1 },
              "rationale": { "type": "string" },
              "evidence_ref": { "type": "string", "minLength": 3 }
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "confidence_statement": { "type": "string" },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitcheck.dev/schemas/llm-explainability-context.schema.json",
  "title": "LlmExplainabilityContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "forecast_latest",
    "explanation",
    "recommendation",
    "history_digest",
    "context_meta",
    "citation_map"
  ],
  "properties": {
    "forecast_latest": {
      "$ref": "https://sitcheck.dev/schemas/forecast-latest-response.schema.json"
    },
    "explanation": {
      "$ref": "https://sitcheck.dev/schemas/explanation.schema.json"
    },
    "recommendation": {
      "$ref": "https://sitcheck.dev/schemas/recommendation.schema.json"
    },
    "history_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_occupancy",
        "last_utilization",
        "trend_15m",
        "trend_60m",
        "quality_score_avg",
        "quality_flags_top",
        "point_count"
      ],
      "properties": {
        "last_occupancy": { "type": "number" },
        "last_utilization": { "type": "number" },
        "trend_15m": { "type": "number" },
        "trend_60m": { "type": "number" },
        "quality_score_avg": { "type": "number", "minimum": 0, "maximum": 1 },
        "quality_flags_top": {
          "type": "array",
          "items": { "type": "string" }
        },
        "point_count": { "type": "integer", "minimum": 0 }
      }
    },
    "scenario_digest": {
      "oneOf": [
        { "$ref": "https://sitcheck.dev/schemas/scenario-result.schema.json" },
        { "type": "null" }
      ]
    },
    "context_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "generated_at",
        "audience",
        "language",
        "timezone",
        "guardrails",
        "query"
      ],
      "properties": {
        "request_id": { "type": "string", "minLength": 3 },
        "generated_at": { "type": "string", "format": "date-time" },
        "audience": { "type": "string", "enum": ["ops", "executive", "enduser", "professor"] },
        "language": { "type": "string", "enum": ["de", "en"] },
        "timezone": { "type": "string", "minLength": 2 },
        "guardrails": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "query": { "type": "string" }
      }
    },
    "citation_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id",
          "evidence_id",
          "source_type",
          "source_id",
          "time_window",
          "model_version",
          "quality_score",
          "quality_flags"
        ],
        "properties": {
          "ref_id": { "type": "string", "minLength": 3 },
          "evidence_id": { "type": "string", "minLength": 3 },
          "source_type": {
            "type": "string",
            "enum": ["counts", "events", "forecast", "xai", "recommendation", "scenario", "api"]
          },
          "source_id": { "type": "string", "minLength": 1 },
          "time_window": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "format": "date-time" },
              "to": { "type": "string", "format": "date-time" }
            }
          },
          "model_version": { "type": "string", "minLength": 1 },
          "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "quality_flags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitcheck.dev/schemas/explanation.schema.json",
  "title": "Explanation",
  "type": "object",
  "additionalProperties": false,
  "required": ["zone_id", "horizon", "summary", "drivers", "uncertainty", "evidence"],
  "properties": {
    "zone_id": { "type": "string", "minLength": 1 },
    "horizon": { "type": "integer", "minimum": 1 },
    "summary": { "type": "string" },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "impact", "direction", "description"],
        "properties": {
          "name": { "type": "string" },
          "impact": { "type": "number" },
          "direction": { "type": "string", "enum": ["up", "down", "mixed"] },
          "description": { "type": "string" }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level", "reason"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "reason": { "type": "string" }
      }
    },
    "evidence": { "$ref": "https://sitcheck.dev/schemas/evidence.schema.json" }
  }
}
